# ============================================================
# Salma Educational Agent — environment variables
# Copy to .env.local and fill in what you need.
# Never commit real secrets. All variables are optional.
# ============================================================

# --- AI explanation service (server-side, optional) ----------
# The app works fully WITHOUT any AI key: bundled original
# explanations are always available and the /api/ai endpoint
# returns a friendly "not configured" message (HTTP 501).
#
# Multi-provider, FREE-FIRST with automatic fallback. Provide a
# key for one or more providers below; the route tries them in
# order (all free tiers first) and falls back on error/timeout.
#
# Optional: override precedence, e.g. "gemini,groq,openrouter"
# AI_PROVIDER_ORDER=groq,gemini,cerebras,openrouter,mistral,together
#
# Optional: force one model for every provider
# AI_MODEL=
#
# --- Free providers (recommended first) ---
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
# Local Ollama needs no key; enable it via AI_PROVIDER_ORDER=...,ollama
OLLAMA_API_KEY=

# --- Paid (kept last in the fallback order) ---
OPENAI_API_KEY=

# --- Custom OpenAI-compatible endpoint ---
# Set AI_API_KEY (+ AI_API_BASE_URL, + optional AI_MODEL) to target
# any OpenAI-compatible server. The base URL must NOT include
# "/chat/completions" — it is appended automatically.
AI_API_KEY=
AI_API_BASE_URL=
AI_MODEL=

# --- App metadata --------------------------------------------
NEXT_PUBLIC_APP_NAME=Salma Educational Agent
NEXT_PUBLIC_APP_LOCALE_DEFAULT=ar

# --- Student sign-in (WhatsApp / email OTP, optional) --------
# Sign-in sends a one-time code to the student's WhatsApp number or
# email and then issues a signed session cookie. Without any provider
# the /api/auth/* endpoints return a friendly 501 and the account page
# explains that sign-in is not configured yet.
#
# AUTH_SECRET signs the session/pending cookies. Set a long random
# string in production (e.g. `openssl rand -hex 32`). In development a
# fixed insecure key is used automatically so the app runs with zero
# setup; production refuses to issue sessions without this.
AUTH_SECRET=

# --- Provider: Twilio Verify (recommended; sends AND checks codes) ---
# 1) Create a Verify Service in the Twilio console.
# 2) Fill the three values below to enable WhatsApp + email codes.
#    (WhatsApp must be approved on the Verify service.)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Dev-only console provider -------------------------------
# Outside production, if Twilio is NOT configured, the app falls back
# to a console provider that logs the code (and returns it to the UI)
# so the flow can be tested. It is ALWAYS disabled in production unless
# you explicitly set AUTH_DEV_OTP=1 (not recommended).
AUTH_DEV_OTP=
